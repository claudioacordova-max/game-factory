{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": ".",
    "outDir": ".test-dist",
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["src/engine/**/*.ts", "tests/**/*.ts", "tests/**/*.tsx"]
}
